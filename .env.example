# ─── Alchemy RPC Endpoints ───────────────────────────────────────────
# Get your API key from https://dashboard.alchemy.com
VITE_ALCHEMY_MAINNET_API_KEY=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
VITE_ALCHEMY_SEPOLIA_API_KEY=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
VITE_ALCHEMY_ARBMAINNET_API_KEY=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
VITE_ALCHEMY_ARBSEPOLIA_API_KEY=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
VITE_ALCHEMY_BASEMAINNET_API_KEY=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
VITE_ALCHEMY_BASESEPOLIA_API_KEY=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ─── WalletConnect ───────────────────────────────────────────────────
# Get your Project ID from https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# ─── Web3Auth (Social Login) ────────────────────────────────────────
# Get your Client ID from https://dashboard.web3auth.io
# Current network: SAPPHIRE_DEVNET (switch to SAPPHIRE_MAINNET for production)
VITE_WEB3AUTH_CLIENT_ID=YOUR_WEB3AUTH_CLIENT_ID

# ─── Confidential wrappers (FHERC20) ─────────────────────────────────
# VITE_*_WRAPPED_* are the ArfheShieldedETH / ArfheShieldedERC20 deployments.
# Deploy them with `cd deploy && npm run deploy:sepolia|deploy:arb|deploy:base`
# and paste the printed addresses here. CoFHE only runs on these three chains.
#
# The addresses below are the pre-migration (cofhejs-era) contracts and are NOT
# compatible with @cofhe/sdk — replace them with your own deployments.

# VITE_*_WRAPPER_FACTORY_ADDRESS deploys wrappers on demand, which is what lets the
# wallet shield arbitrary ERC-20s rather than only the two below.
#
# VITE_*_WRAPPED_USDC_ADDRESS must be the wrapper the FACTORY registered for USDC — the
# deploy script creates it through the factory and prints that address. A hand-deployed
# wrapper is not in the registry, so the first user to enable shielding for USDC makes the
# factory deploy a second one. Two wrappers around one token hold two separate backing
# pools: what is shielded through one cannot be unshielded through the other, and both
# render as "aeUSDC" with nothing to tell them apart.
#
# VITE_*_WRAPPED_ETH_ADDRESS has no such constraint — the factory only wraps ERC-20s, so
# the native wrapper cannot collide with a registry entry.

# Sepolia
VITE_WRAPPED_ETH_ADDRESS=
VITE_WRAPPED_USDC_ADDRESS=
VITE_WRAPPER_FACTORY_ADDRESS=
VITE_SEPOLIA_WETH_ADDRESS=0x7b79995e5f793A07Bc00c21412e50Ecae098E7f9
VITE_SEPOLIA_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Arbitrum Sepolia
VITE_ARB_WRAPPED_ETH_ADDRESS=
VITE_ARB_WRAPPED_USDC_ADDRESS=
VITE_ARB_WRAPPER_FACTORY_ADDRESS=
VITE_ARB_SEPOLIA_WETH_ADDRESS=0x980B62Da83eFf3D4576C647993b0c1D7faf17c73
VITE_ARB_SEPOLIA_USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d

# Base Sepolia
VITE_BASE_WRAPPED_ETH_ADDRESS=
VITE_BASE_WRAPPED_USDC_ADDRESS=
VITE_BASE_WRAPPER_FACTORY_ADDRESS=
VITE_BASE_SEPOLIA_WETH_ADDRESS=0x4200000000000000000000000000000000000006
VITE_BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ─── Deploy (DO NOT commit real keys!) ───────────────────────────────
# DEPLOYER_PRIVATE_KEY=0x... (only in local .env, NEVER commit)
