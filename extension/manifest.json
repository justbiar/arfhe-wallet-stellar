{
    "manifest_version": 3,
    "key": "",
    "name": "Arfhe Wallet",
    "version": "1.0.0",
    "version_name": "1.0.0 (public testnet)",
    "description": "Privacy-first FHE wallet with encrypted on-chain balances. Public testnet release — Sepolia, Base Sepolia and Arbitrum Sepolia. Do not use with mainnet funds.",
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self'; img-src 'self' data: https:; connect-src 'self' https: http: wss: ws: data: blob:"
    },
    "action": {
        "default_popup": "index.html",
        "default_title": "Arfhe Wallet",
        "default_icon": {
            "32": "icon32.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "permissions": [
        "storage",
        "notifications",
        "alarms"
    ],
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "content-script.js"
            ],
            "run_at": "document_start"
        }
    ],
    "host_permissions": [
        "https://*/*",
        "http://*/*",
        "ws://*/*",
        "wss://*/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "inpage.js"
            ],
            "matches": [
                "http://*/*",
                "https://*/*"
            ]
        }
    ],
    "icons": {
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}
