{
  "manifest_version": 3,
  "key": "",
  "name": "Arfhe Wallet",
  "version": "1.0.1",
  "version_name": "1.0.1 (public testnet)",
  "description": "FHE wallet with encrypted on-chain balances. Public testnet only — Sepolia, Base Sepolia and Arbitrum Sepolia. No real funds.",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; media-src 'self'; img-src 'self' data: https:; connect-src 'self' https: http: wss: ws: data: blob:"
  },
  "action": {
    "default_title": "Arfhe Wallet",
    "default_icon": {
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "sidePanel"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "ws://*/*",
    "wss://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inpage.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "side_panel": {
    "default_path": "index.html?surface=sidepanel"
  },
  "minimum_chrome_version": "114"
}
