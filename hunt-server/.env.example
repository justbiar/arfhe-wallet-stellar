# Arfhe hunt server — kopyala: cp .env.example .env
#
# Bu dosyada kelime YOK. Kelimeler fragments.json'da, o da .gitignore'da.

PORT=8787

# Kapıları doğrulamak için. Cüzdanın kullandığı anahtarların aynısı olabilir —
# bu sunucu sadece okuma yapıyor (eth_getLogs, eth_getTransactionCount).
RPC_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/ANAHTARINIZ
RPC_ARB_SEPOLIA=https://arb-sepolia.g.alchemy.com/v2/ANAHTARINIZ
RPC_BASE_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/ANAHTARINIZ

# Uzantının kendi kaynağı. Kimlik doğrulaması DEĞİL — imza o işi yapıyor — ama
# sıradan bir web sayfasının bunu ziyaretçi adına çağırmasını engeller.
ALLOWED_ORIGINS=chrome-extension://jdihllmgakeejednibihnpclbddgfchp

FRAGMENTS_FILE=./fragments.json
CLAIMS_FILE=./claims.json
