{
  "manifest_version": 2,
  "version": "1.0.0",
  "name": "Arfhe",
  "browser_action": {
    "default_popup": "index.html",
    "default_icon": {
      "32": "icon48.png"
    }
  },
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "icons": {
    "32": "icon48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": []
    }
  ]
}
